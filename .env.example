# Copy to ".env.local" in the project root (Vite loads it automatically; "*.local" is gitignored).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional production canonical origin for generated SEO HTML (HTTPS origin only).
VITE_SITE_URL=https://www.shivaagriclinic.com

# Optional server-side override for the public YouTube RSS feed; the channel ID is already built in.
YOUTUBE_CHANNEL_ID=

# Optional server-only social counts. Never prefix these with VITE_ or commit real tokens.
# YouTube channels.list statistics uses the same channel ID as the RSS feed.
YOUTUBE_API_KEY=
# Facebook Page ID and a Page access token allowed to read followers_count.
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
# Instagram professional account ID and a Facebook Graph API token permitted to read that IG User.
# Leave META_IG_ACCESS_TOKEN blank when the Page token can read the connected IG account.
META_IG_USER_ID=
META_IG_ACCESS_TOKEN=
