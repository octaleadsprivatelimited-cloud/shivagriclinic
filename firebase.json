{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "redirects": [
      { "source": "/services/crop-advisory", "destination": "/crop-management", "type": 301 },
      { "source": "/services/crop-management", "destination": "/crop-management", "type": 301 },
      { "source": "/services/**", "destination": "/videos", "type": 301 },
      { "source": "/products/**", "destination": "/videos", "type": 301 },
      { "source": "/solutions/**", "destination": "/videos", "type": 301 },
      { "source": "/resources", "destination": "/videos", "type": 301 },
      { "source": "/gallery", "destination": "/videos", "type": 301 },
      { "source": "/knowledge-base", "destination": "/videos", "type": 301 },
      { "source": "/careers", "destination": "/about", "type": 301 }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
          { "key": "X-Frame-Options", "value": "DENY" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
        ]
      },
      {
        "source": "/admin{,/**}",
        "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }]
      },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ],
    "rewrites": [
      { "source": "/videos", "destination": "/videos/index.html" },
      { "source": "/about", "destination": "/about/index.html" },
      { "source": "/crop-management", "destination": "/crop-management/index.html" },
      { "source": "/contact", "destination": "/contact/index.html" },
      { "source": "/team", "destination": "/team/index.html" },
      { "source": "/featured-in", "destination": "/featured-in/index.html" },
      { "source": "/blog", "destination": "/blog/index.html" },
      { "source": "/case-studies", "destination": "/case-studies/index.html" },
      { "source": "/privacy-policy", "destination": "/privacy-policy/index.html" },
      { "source": "/terms", "destination": "/terms/index.html" },
      { "source": "/watch/**", "destination": "/watch/index.html" },
      { "source": "/blog/**", "destination": "/blog-post/index.html" },
      { "source": "**", "destination": "/spa-fallback.html" }
    ]
  },
  "firestore": {
    "rules": "firebase/rules/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  }
}
