rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Grant the admin claim only from a trusted Firebase Admin SDK environment.
    // The claim alone cannot authorize another Firebase account or sign-in method.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.admin == true
        && request.auth.token.email == 'shivaagriclinic@gmail.com'
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    // The public channel site reads its editable content from this one document.
    match /settings/channel {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Video records contain public YouTube IDs and editor-supplied display settings.
    match /videos/{videoId} {
      allow read: if true;
      allow create, update, delete: if isAdmin()
        && videoId.matches('[A-Za-z0-9_-]{11}');
    }

    // Published editorial content is public. Drafts are visible only to admins.
    match /blogPosts/{slug} {
      allow read: if isAdmin() || resource.data.status == 'published';
      allow create, update, delete: if isAdmin()
        && slug.matches('[a-z0-9]+(-[a-z0-9]+)*');
    }

    // These collections are edited by the admin panel and displayed publicly.
    match /teamMembers/{memberId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /galleryItems/{itemId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.type == 'image'
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() < 1000000;
      allow delete: if isAdmin();
    }
    match /caseStudies/{studyId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /featuredIn/{clippingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Legacy product, inquiry, and seed collections remain closed to this site.
    // Do not deploy these narrowed rules until the old site is retired.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
